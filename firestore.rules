rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each family's data lives under households/{hid}. Members are households/{hid}/members/{uid}.
    // users/{uid} → {hid} says which family a sign-in belongs to.
    //
    // The original family (households/main) can still be claimed by the two emails below.
    // Put your real emails here in the Firebase console only (lowercase) — never in this public repo.
    function signedIn() { return request.auth != null; }
    // An allowlisted email the owner has removed is revoked for good: households/main/revoked/{email} blocks the
    // allowlist path (membership claim, data access, creating the family record). Re-inviting them with a code still works.
    function legacy() {
      return signedIn() && request.auth.token.email in ['parent1@example.com', 'parent2@example.com']
        && !exists(/databases/$(database)/documents/households/main/revoked/$(request.auth.token.email.lower()));
    }
    function house(hid) { return /databases/$(database)/documents/households/$(hid); }
    function member(hid) {
      return signedIn() && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }
    function owner(hid) {
      return signedIn() && exists(house(hid)) && get(house(hid)).data.owner == request.auth.uid;
    }
    function inFamily(hid) { return member(hid) || (hid == 'main' && legacy()); }
    // Journey events (Phase 2): the same shape the app enforces. `src` is a provenance marker only ("checkin" for a
    // Phase 3 shared check-in) and can never carry an id or any private data.
    function validEvent(d) {
      return d.keys().hasAll(['kind', 'scope', 'i', 't', 'title'])
        && d.keys().hasOnly(['kind', 'scope', 'i', 'key', 't', 'title', 'note', 'ref', 'src', 'by', 'createdT', 'editT', 'editBy'])
        && d.kind in ['milestone', 'journal', 'moment']
        && d.scope in ['baby', 'parent', 'family']
        && ((d.scope == 'baby' && d.i in [0, 1]) || (d.scope != 'baby' && d.i == null))
        && d.t is number
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && (!('note' in d) || (d.note is string && d.note.size() <= 2000))
        && (!('key' in d) || d.key == null || (d.key is string && d.key.size() <= 40))
        && (!('src' in d) || d.src == null || d.src == 'checkin')
        && (!('ref' in d) || d.ref == null || (d.ref is map && d.ref.keys().hasOnly(['col', 'id']) && d.ref.col is string && d.ref.id is string));
    }

    // Milk sources (Phase 2b). The same shapes the app enforces (milk-sources.js). Amounts are integer tenths of a mL.
    function srcParts(m) {
      return m is map && m.keys().hasAll(['mom', 'donor', 'formula']) && m.keys().hasOnly(['mom', 'donor', 'formula'])
        && m.mom is int && m.donor is int && m.formula is int && m.mom >= 0 && m.donor >= 0 && m.formula >= 0;
    }
    // One allocation per scheduled occurrence: the id is derived from (baby index, occurrence time).
    function validAlloc(id, d) {
      return d.keys().hasAll(['i', 't', 'state', 'mL10', 'total10', 'basis', 'rev', 'by', 'editT', 'editBy'])
        && d.keys().hasOnly(['i', 't', 'state', 'mL10', 'total10', 'basis', 'rev', 'by', 'editT', 'editBy'])
        && d.i in [0, 1] && d.t is int && id == 'b' + string(d.i) + '-' + string(d.t)
        && d.rev is int && d.rev >= 1 && d.by is string && d.editBy is string && d.editT is number
        && ((d.state == 'usual' && d.mL10 == null && d.total10 == null && d.basis == null)
          || (d.state == 'set' && srcParts(d.mL10) && d.total10 is int && d.total10 > 0
              && d.total10 == d.mL10.mom + d.mL10.donor + d.mL10.formula
              // basis feed: the parts total the logged by-mouth amount, which the app already limits to 0–150 mL
              && ((d.basis == 'feed' && d.total10 <= 1500) || d.basis == 'scheduled')));
    }
    // Usual-milk history: whole percentages that total exactly 100, or null ("Not recorded" from here on).
    function validUsual(id, d) {
      return d.keys().hasAll(['i', 'from', 'pct', 'by']) && d.keys().hasOnly(['i', 'from', 'pct', 'by'])
        && d.i in [0, 1] && d.from is int && d.from >= 0 && d.by is string
        && id.matches('u-' + string(d.i) + '-' + string(d.from) + '-[a-z0-9]{4}')
        && (d.pct == null || (srcParts(d.pct) && d.pct.mom <= 100 && d.pct.donor <= 100 && d.pct.formula <= 100
            && d.pct.mom + d.pct.donor + d.pct.formula == 100));
    }
    // Schedule history for families that use milk sources: the values the feed grid and scheduled amounts come from.
    function validPeriod(id, d) {
      return d.keys().hasAll(['from', 'everyH', 'startH', 'dayH', 'slotMin', 'full10', 'src', 'by'])
        && d.keys().hasOnly(['from', 'everyH', 'startH', 'dayH', 'slotMin', 'full10', 'src', 'by'])
        && d.from is int && d.from >= 0 && id.matches('s-' + string(d.from) + '-[a-z0-9]{4}')
        && d.everyH in [2, 3, 4] && d.startH is int && d.startH >= 0 && d.startH <= 23 && d.dayH is int && d.dayH >= 0 && d.dayH <= 12
        && d.slotMin is list && d.slotMin.size() == 2 && d.slotMin[0] in [0, 30] && d.slotMin[1] in [0, 30]
        && d.full10 is list && d.full10.size() == 2 && d.full10[0] is int && d.full10[1] is int && d.full10[0] > 0 && d.full10[1] > 0
        && d.src in ['setup', 'first-use', 'observed'] && d.by is string;
    }

    // Milk-source activation (Phase 2b): the record that switches tracking on. It names the member accounts (uids) it
    // relies on; each named account must be a current member whose own version marker is at the required version, and
    // the signer must be one of them. A uid is an account, not a device; the marker is self-reported by that account's
    // app, not proof of what any device runs. Rules can't list the members collection, so they can't prove no member was
    // left out: the app always names every member from a server read (Store.activateSources). Unrolled for up to 4
    // accounts (rules have no loops; this also stays within the per-request document-read limit).
    function phoneReady(hid, u) {
      return exists(/databases/$(database)/documents/households/$(hid)/members/$(u))
        && get(/databases/$(database)/documents/households/$(hid)/clients/$(u)).data.v >= 1;
    }
    function validActivation(hid, d) {
      return d.keys().hasAll(['on', 't', 'by', 'phones']) && d.keys().hasOnly(['on', 't', 'by', 'phones'])
        && d.on == true && d.t is number && d.by == request.auth.token.email.lower()
        && d.phones is list && d.phones.size() >= 1 && d.phones.size() <= 4 && request.auth.uid in d.phones
        && phoneReady(hid, d.phones[0])
        && (d.phones.size() < 2 || phoneReady(hid, d.phones[1]))
        && (d.phones.size() < 3 || phoneReady(hid, d.phones[2]))
        && (d.phones.size() < 4 || phoneReady(hid, d.phones[3]));
    }

    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['hid']) && member(request.resource.data.hid);
    }

    // Invite codes: anyone signed in can look up one code they were given (no listing).
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if member(request.resource.data.hid) && get(house(request.resource.data.hid)).data.code == code;
      allow delete: if member(resource.data.hid);
    }

    match /households/{hid} {
      allow get: if inFamily(hid);
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && (hid != 'main' || legacy());
      // Members can refresh the invite code; ownership only passes to another member.
      allow update: if member(hid)
        && (request.resource.data.owner == resource.data.owner
            || (owner(hid) && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.resource.data.owner))));
      allow delete: if owner(hid);

      match /members/{uid} {
        allow read: if inFamily(hid) || (signedIn() && request.auth.uid == uid);
        // Join yourself: as the owner, as an original-family email, or with the current, unexpired invite code.
        allow create: if signedIn() && request.auth.uid == uid && (
          owner(hid)
          || (hid == 'main' && legacy())
          || (exists(house(hid))
              && request.resource.data.code == get(house(hid)).data.code
              && request.time.toMillis() < get(house(hid)).data.codeExp));
        allow update: if false;
        allow delete: if signedIn() && (request.auth.uid == uid || owner(hid));
      }

      // All shared family data: feeds, weights, pumps, drops, checklist, plans, questions, needs, config.
      // `members`, `private`, `revoked`, `events`, `slotMilk`, `milkUsual`, `schedPeriods` and `clients` are excluded here on purpose (each has its own rule below): Firestore rules are additive, so if this catch-all
      // matched them, any family member could read another member's private subtree regardless of the rules below.
      match /{col}/{rest=**} {
        allow read, write: if !(col in ['members', 'private', 'revoked', 'events', 'slotMilk', 'milkUsual', 'schedPeriods', 'clients', 'config']) && inFamily(hid);
      }

      // Journey events: family members read and delete; every create/update must match the event shape.
      match /events/{eid} {
        allow read, delete: if inFamily(hid);
        allow create, update: if inFamily(hid) && validEvent(request.resource.data);
      }

      // Milk-source allocations: create only when absent; every change must carry rev = stored rev + 1, so an edit made
      // from a stale copy (two parents, or a phone that was offline) is refused instead of silently overwriting.
      // "Use usual milk" is an update (state "usual"), not a delete; deletes are for Undo of a create and lifecycle.
      match /slotMilk/{aid} {
        allow read, delete: if inFamily(hid);
        allow create: if inFamily(hid) && validAlloc(aid, request.resource.data);
        allow update: if inFamily(hid) && validAlloc(aid, request.resource.data)
          && request.resource.data.rev == resource.data.rev + 1
          && request.resource.data.i == resource.data.i && request.resource.data.t == resource.data.t
          && request.resource.data.editBy == request.auth.token.email.lower();
      }
      // Usual-milk and schedule history: append-only (create, or delete for Undo and lifecycle); never edited.
      match /milkUsual/{uid} {
        allow read, delete: if inFamily(hid);
        allow create: if inFamily(hid) && validUsual(uid, request.resource.data);
      }
      match /schedPeriods/{pid} {
        allow read, delete: if inFamily(hid);
        allow create: if inFamily(hid) && validPeriod(pid, request.resource.data);
      }
      // Which app version each member's phone runs (milk-source tracking starts only once every phone is updated).
      // Each person writes only their own; any member may delete (lifecycle), which only ever blocks, never unlocks.
      // Config: every document as before, except the activation record, which has its own rule below.
      match /config/{cfg} {
        allow read: if inFamily(hid);
        allow write: if inFamily(hid) && cfg != 'sources';
      }
      // Activation: create only, by a member (redundant with phoneReady for the signer; kept as defence in depth), naming
      // ready accounts. Never updated, so it can't be overwritten. Deleting it only switches tracking off: source data in
      // slotMilk / milkUsual / schedPeriods is untouched. Members may delete it (the last member out deletes all config).
      match /config/sources {
        allow create: if member(hid) && validActivation(hid, request.resource.data);
        allow delete: if inFamily(hid);
      }
      match /clients/{cuid} {
        allow read, delete: if inFamily(hid);
        allow create, update: if inFamily(hid) && request.auth.uid == cuid
          && request.resource.data.keys().hasAll(['v', 't']) && request.resource.data.keys().hasOnly(['v', 't'])
          && request.resource.data.v is int && request.resource.data.v >= 1 && request.resource.data.t is number;
      }

      // Revocations (original family only): written by the owner when removing an allowlisted member. A revocation stays
      // in place if the owner later re-invites that person with a code (membership grants access while they're invited),
      // so removing them again simply rewrites it. Members and the revoked person can't create, edit or delete them;
      // only the owner can (to undo a revocation, or when deleting the family).
      match /revoked/{em} {
        allow get: if inFamily(hid) || (signedIn() && request.auth.token.email.lower() == em);
        allow list: if inFamily(hid);
        // Update: removing a deliberately re-invited parent a second time rewrites their existing revocation.
        allow create, update: if hid == 'main' && owner(hid) && em == em.lower();
        allow delete: if owner(hid);
      }

      // Each person's private subtree: households/{hid}/private/{uid}/{collection}/{doc}
      // (e.g. Parent Support check-ins). Only the person whose uid is in the path can touch it — never the other
      // parent, never a stranger, and never via the legacy allowlist for households/main.
      match /private/{uid}/{name}/{docId} {
        // Read (get + list) and delete need only "it's my uid", NOT current membership. This is the narrow
        // removed-member cleanup exception: when the owner removes a parent, that parent loses all family access,
        // but the app must still be able to find and delete their own private documents the next time they open it
        // (product decision D10). It grants nothing outside this person's own subtree and never restores membership.
        allow read, delete: if signedIn() && request.auth.uid == uid;
        // Creating or changing private data still requires being an active member of the family.
        allow create, update: if signedIn() && request.auth.uid == uid && member(hid);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
