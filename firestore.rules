rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each family's data lives under households/{hid}. Members are households/{hid}/members/{uid}.
    // users/{uid} → {hid} says which family a sign-in belongs to.
    //
    // The original family (households/main) can still be claimed by the two emails below.
    // Put your real emails here in the Firebase console only (lowercase) — never in this public repo.
    function signedIn() { return request.auth != null; }
    // An allowlisted email the owner has removed is revoked for good: households/main/revoked/{email} blocks the
    // allowlist path (membership claim, data access, creating the family record). Re-inviting them with a code still works.
    function legacy() {
      return signedIn() && request.auth.token.email in ['parent1@example.com', 'parent2@example.com']
        && !exists(/databases/$(database)/documents/households/main/revoked/$(request.auth.token.email.lower()));
    }
    function house(hid) { return /databases/$(database)/documents/households/$(hid); }
    function member(hid) {
      return signedIn() && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }
    function owner(hid) {
      return signedIn() && exists(house(hid)) && get(house(hid)).data.owner == request.auth.uid;
    }
    function inFamily(hid) { return member(hid) || (hid == 'main' && legacy()); }

    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['hid']) && member(request.resource.data.hid);
    }

    // Invite codes: anyone signed in can look up one code they were given (no listing).
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if member(request.resource.data.hid) && get(house(request.resource.data.hid)).data.code == code;
      allow delete: if member(resource.data.hid);
    }

    match /households/{hid} {
      allow get: if inFamily(hid);
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && (hid != 'main' || legacy());
      // Members can refresh the invite code; ownership only passes to another member.
      allow update: if member(hid)
        && (request.resource.data.owner == resource.data.owner
            || (owner(hid) && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.resource.data.owner))));
      allow delete: if owner(hid);

      match /members/{uid} {
        allow read: if inFamily(hid) || (signedIn() && request.auth.uid == uid);
        // Join yourself: as the owner, as an original-family email, or with the current, unexpired invite code.
        allow create: if signedIn() && request.auth.uid == uid && (
          owner(hid)
          || (hid == 'main' && legacy())
          || (exists(house(hid))
              && request.resource.data.code == get(house(hid)).data.code
              && request.time.toMillis() < get(house(hid)).data.codeExp));
        allow update: if false;
        allow delete: if signedIn() && (request.auth.uid == uid || owner(hid));
      }

      // All shared family data: feeds, weights, pumps, drops, checklist, plans, questions, events, needs, config.
      // `members`, `private` and `revoked` are excluded here on purpose: Firestore rules are additive, so if this catch-all
      // matched them, any family member could read another member's private subtree regardless of the rules below.
      match /{col}/{rest=**} {
        allow read, write: if !(col in ['members', 'private', 'revoked']) && inFamily(hid);
      }

      // Revocations (original family only): written by the owner when removing an allowlisted member. Members can't
      // edit or delete them; only the owner can (to undo a revocation, or when deleting the family).
      match /revoked/{em} {
        allow get: if inFamily(hid) || (signedIn() && request.auth.token.email.lower() == em);
        allow list: if inFamily(hid);
        allow create: if hid == 'main' && owner(hid) && em == em.lower();
        allow update: if false;
        allow delete: if owner(hid);
      }

      // Each person's private subtree: households/{hid}/private/{uid}/{collection}/{doc}
      // (e.g. Parent Support check-ins). Only the person whose uid is in the path can touch it — never the other
      // parent, never a stranger, and never via the legacy allowlist for households/main.
      match /private/{uid}/{name}/{docId} {
        // Read (get + list) and delete need only "it's my uid", NOT current membership. This is the narrow
        // removed-member cleanup exception: when the owner removes a parent, that parent loses all family access,
        // but the app must still be able to find and delete their own private documents the next time they open it
        // (product decision D10). It grants nothing outside this person's own subtree and never restores membership.
        allow read, delete: if signedIn() && request.auth.uid == uid;
        // Creating or changing private data still requires being an active member of the family.
        allow create, update: if signedIn() && request.auth.uid == uid && member(hid);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
